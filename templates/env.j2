# Managed by Ansible. Root-readable only.
DIRECTOR_PROJECT={{ appjail_inventree_project | to_json }}
INVENTREE_ADMIN_USER={{ appjail_inventree_admin_user | to_json }}
INVENTREE_ADMIN_PASSWORD={{ appjail_inventree_admin_password | to_json }}
INVENTREE_ADMIN_EMAIL={{ appjail_inventree_admin_email | to_json }}
INVENTREE_SECRET_KEY={{ appjail_inventree_secret_key | to_json }}
INVENTREE_TRUSTED_ORIGINS={{ appjail_inventree_trusted_origins | to_json }}
INVENTREE_DB_PASSWORD={{ appjail_inventree_db_password | to_json }}
INVENTREE_DB_ROOT_PASSWORD={{ appjail_inventree_db_root_password | to_json }}
INVENTREE_PLATFORM_UI={{ ('1' if appjail_inventree_platform_ui | bool else '0') | to_json }}
INVENTREE_GUNICORN_WORKERS={{ appjail_inventree_gunicorn_workers | to_json }}
INVENTREE_GUNICORN_TIMEOUT={{ appjail_inventree_gunicorn_timeout | to_json }}
COPYDIR_FILES={{ (appjail_inventree_project_dir + '/copydir-files') | to_json }}
{% for variable in appjail_inventree_extra_environment %}
EXTRA_{{ variable.name }}={{ variable.value | string | to_json }}
{% endfor %}
